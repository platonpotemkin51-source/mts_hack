{
  "openapi": "3.1.0",
  "info": {
    "title": "Energytool Consultant — target API",
    "version": "1.0.0",
    "description": "Implemented web API. See docs/CONTRACTS.md."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Service health and chat readiness",
        "responses": {
          "200": {
            "description": "Server state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "operationId": "readiness",
        "summary": "200 when knowledge base and model settings are available; otherwise 503",
        "responses": {
          "200": {"description": "Ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}},
          "503": {"description": "Not ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}
        }
      }
    },
    "/api/requests/{request_id}/close": {
      "post": {
        "operationId": "cancelChatRequest",
        "summary": "Close the session associated with a pending or completed client request",
        "parameters": [{"name": "request_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"204": {"description": "Cancelled"}}
      }
    },
    "/api/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create an empty session",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummary"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listSessions",
        "summary": "Archive, including sessions without leads",
        "responses": {
          "200": {
            "description": "All sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "chat",
        "summary": "Consult within one session; request_id makes retries idempotent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consultation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Session closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "get": {
        "operationId": "getSession",
        "summary": "Read archived history without resuming it",
        "responses": {
          "200": {
            "description": "History",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetail"
                }
              }
            }
          },
          "404": {
            "description": "Unknown session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/close": {
      "parameters": [
        {
          "name": "session_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "post": {
        "operationId": "closeSession",
        "summary": "Idempotently close without deleting history",
        "responses": {
          "200": {
            "description": "Closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/leads": {
      "post": {
        "operationId": "createLead",
        "summary": "Save an internal lead with explicit consent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead saved; no external delivery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Closed session or existing lead",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or missing consent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "chat_ready": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "chat_ready"
        ]
      },
      "KnowledgeChunk": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "chunk_id",
          "source",
          "title",
          "text",
          "score"
        ]
      },
      "ClientBrief": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manager_summary": {
            "type": ["string", "null"],
            "maxLength": 800
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "known_parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended_products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "object",
          "problem",
          "known_parameters",
          "recommended_products",
          "missing_fields"
        ]
      },
      "Timings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "retrieval_ms": {
            "type": "number",
            "minimum": 0
          },
          "generation_ms": {
            "type": "number",
            "minimum": 0
          },
          "total_ms": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "retrieval_ms",
          "generation_ms",
          "total_ms"
        ]
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": ["string", "null"],
            "minLength": 8,
            "maxLength": 100,
            "description": "Client-generated ID for safe retry and lost-request cancellation"
          },
          "debug": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "session_id",
          "message"
        ]
      },
      "ChatResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnowledgeChunk"
            }
          },
          "brief": {
            "$ref": "#/components/schemas/ClientBrief"
          },
          "lead_offer": {
            "type": "boolean"
          },
          "debug": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timings"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "session_id",
          "answer",
          "sources",
          "brief",
          "lead_offer",
          "debug"
        ]
      },
      "SessionSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "closed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "session_id",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "role",
          "content",
          "created_at"
        ]
      },
      "LeadRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "full_name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "consent": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "session_id",
          "full_name",
          "phone",
          "company",
          "consent"
        ]
      },
      "LeadResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lead_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "lead_id",
          "session_id",
          "summary",
          "created_at"
        ]
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "SessionDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lead": {
            "oneOf": [
              {"$ref": "#/components/schemas/LeadResponse"},
              {"type": "null"}
            ]
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "closed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "brief": {
            "$ref": "#/components/schemas/ClientBrief"
          },
          "lead_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "session_id",
          "status",
          "created_at",
          "updated_at",
          "messages",
          "brief",
          "lead_id"
        ]
      }
    }
  }
}
