# Copy to .env. Never commit real keys, KB, transcripts or customer contacts.
# OpenAI-compatible API: base URL including provider's /v1 if required.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Groq has no embeddings API. bm25 works with this provider.
# The selected platform version (61.664) uses hybrid + BAAI/bge-m3.
# Hybrid requires the same LLM_BASE_URL to support /embeddings.
RETRIEVAL_MODE=bm25
EMBEDDER_API_KEY=
EMB_MODEL=BAAI/bge-m3
TEMPERATURE=0.2
MAX_TOKENS=2048
TOP_K=6
SESSION_IDLE_MINUTES=60

# Localhost only. Change CORS_ORIGINS as well if changing UI_PORT.
UI_PORT=5173
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
